# LibreChat API base URL (no trailing slash)
LIBRECHAT_API_URL=https://chat.example.com

# Agent ID or model name
LIBRECHAT_AGENT_ID=agent_xxxxx

# Entra ID SSO (Nested App Authentication) — required.
# ENTRA_CLIENT_ID: Application (client) ID of the add-in's SPA app registration.
# ENTRA_TENANT_ID: Directory (tenant) ID — the add-in is single-tenant.
# ENTRA_API_SCOPE: full scope URI exposed on LibreChat's app registration,
#                  e.g. api://<librechat-client-id>/access_as_user
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_API_SCOPE=api://librechat-client-id/access_as_user

# Optional: white-label branding.
# APP_NAME is shown in the task pane title/header and injected wherever the
# UI references the product name. Defaults to "AI Assistant" when unset.
APP_NAME=AI Assistant

# Optional: absolute URL to your own logo for the task pane header.
# If unset, the bundled assets/icon-32.png is used. To rebrand the ribbon and
# store icons too, replace the files in assets/ and the icon URLs in manifest.xml.
APP_LOGO_URL=

# Optional: environment badge drawn on the main app icon at runtime.
# Accepted values: DEV, STB. Leave unset/empty for PROD (no badge).
# The labeled icon variants are pre-generated at build time.
ICON_LABEL=DEV
