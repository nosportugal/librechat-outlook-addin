<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>NOS Portugal</ProviderName>
  <DefaultLocale>pt-PT</DefaultLocale>
  <DisplayName DefaultValue="AI Assistant" />
  <Description DefaultValue="Leverage AI to enhance your email experience." />

  <IconUrl DefaultValue="https://localhost:3000/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-128.png" />

  <SupportUrl DefaultValue="https://github.com/nosportugal/librechat-outlook-addin" />

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="LibreChatGroup">
                <Label resid="GroupLabel" />

                <Control xsi:type="Button" id="SummarizeButton">
                  <Label resid="SummarizeButton.Label" />
                  <Supertip>
                    <Title resid="SummarizeButton.Label" />
                    <Description resid="SummarizeButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconSummarize.16x16" />
                    <bt:Image size="32" resid="IconSummarize.32x32" />
                    <bt:Image size="80" resid="IconSummarize.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="SummarizeTaskpane.Url" />
                  </Action>
                </Control>

                <Control xsi:type="Menu" id="ReplyMenu">
                  <Label resid="ReplyButton.Label" />
                  <Supertip>
                    <Title resid="ReplyButton.Label" />
                    <Description resid="ReplyButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconReply.16x16" />
                    <bt:Image size="32" resid="IconReply.32x32" />
                    <bt:Image size="80" resid="IconReply.80x80" />
                  </Icon>
                  <Items>
                    <Item id="ReadReplyDefault">
                      <Label resid="ComposeDefaultReply.Label" />
                      <Supertip>
                        <Title resid="ComposeDefaultReply.Label" />
                        <Description resid="ComposeDefaultReply.Tooltip" />
                      </Supertip>
                      <Icon>
                        <bt:Image size="16" resid="IconReply.16x16" />
                        <bt:Image size="32" resid="IconReply.32x32" />
                        <bt:Image size="80" resid="IconReply.80x80" />
                      </Icon>
                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>replyWithAI</FunctionName>
                      </Action>
                    </Item>
                    <Item id="ReadReplyCustom">
                      <Label resid="ComposeCustomReply.Label" />
                      <Supertip>
                        <Title resid="ComposeCustomReply.Label" />
                        <Description resid="ComposeCustomReply.Tooltip" />
                      </Supertip>
                      <Icon>
                        <bt:Image size="16" resid="IconReply.16x16" />
                        <bt:Image size="32" resid="IconReply.32x32" />
                        <bt:Image size="80" resid="IconReply.80x80" />
                      </Icon>
                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>readReplyCustom</FunctionName>
                      </Action>
                    </Item>
                  </Items>
                </Control>

                <Control xsi:type="Button" id="SettingsButton">
                  <Label resid="SettingsButton.Label" />
                  <Supertip>
                    <Title resid="SettingsButton.Label" />
                    <Description resid="SettingsButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconSettings.16x16" />
                    <bt:Image size="32" resid="IconSettings.32x32" />
                    <bt:Image size="80" resid="IconSettings.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="SettingsTaskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="LibreChatComposeGroup">
                <Label resid="ComposeGroupLabel" />

                <Control xsi:type="Menu" id="LibreChatComposeMenu">
                  <Label resid="ComposeGroupLabel" />
                  <Supertip>
                    <Title resid="ComposeGroupLabel" />
                    <Description resid="ReplyButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconLibreChat.16x16" />
                    <bt:Image size="32" resid="IconLibreChat.32x32" />
                    <bt:Image size="80" resid="IconLibreChat.80x80" />
                  </Icon>
                  <Items>
                    <Item id="ComposeReplyDefault">
                      <Label resid="ComposeDefaultReply.Label" />
                      <Supertip>
                        <Title resid="ComposeDefaultReply.Label" />
                        <Description resid="ComposeDefaultReply.Tooltip" />
                      </Supertip>
                      <Icon>
                        <bt:Image size="16" resid="IconReply.16x16" />
                        <bt:Image size="32" resid="IconReply.32x32" />
                        <bt:Image size="80" resid="IconReply.80x80" />
                      </Icon>
                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>composeReplyDefault</FunctionName>
                      </Action>
                    </Item>
                    <Item id="ComposeReplyCustom">
                      <Label resid="ComposeCustomReply.Label" />
                      <Supertip>
                        <Title resid="ComposeCustomReply.Label" />
                        <Description resid="ComposeCustomReply.Tooltip" />
                      </Supertip>
                      <Icon>
                        <bt:Image size="16" resid="IconReply.16x16" />
                        <bt:Image size="32" resid="IconReply.32x32" />
                        <bt:Image size="80" resid="IconReply.80x80" />
                      </Icon>
                      <Action xsi:type="ExecuteFunction">
                        <FunctionName>composeReplyCustom</FunctionName>
                      </Action>
                    </Item>
                    <Item id="ComposeTone">
                      <Label resid="ToneMenu.Label" />
                      <Supertip>
                        <Title resid="ToneMenu.Label" />
                        <Description resid="ToneMenu.Tooltip" />
                      </Supertip>
                      <Icon>
                        <bt:Image size="16" resid="IconTone.16x16" />
                        <bt:Image size="32" resid="IconTone.32x32" />
                        <bt:Image size="80" resid="IconTone.80x80" />
                      </Icon>
                      <Action xsi:type="ShowTaskpane">
                        <SourceLocation resid="Tone.Url" />
                      </Action>
                    </Item>
                  </Items>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="IconSummarize.16x16" DefaultValue="https://localhost:3000/assets/icon-summarize-16.png" />
        <bt:Image id="IconSummarize.32x32" DefaultValue="https://localhost:3000/assets/icon-summarize-32.png" />
        <bt:Image id="IconSummarize.80x80" DefaultValue="https://localhost:3000/assets/icon-summarize-80.png" />
        <bt:Image id="IconReply.16x16" DefaultValue="https://localhost:3000/assets/icon-reply-16.png" />
        <bt:Image id="IconReply.32x32" DefaultValue="https://localhost:3000/assets/icon-reply-32.png" />
        <bt:Image id="IconReply.80x80" DefaultValue="https://localhost:3000/assets/icon-reply-80.png" />
        <bt:Image id="IconSettings.16x16" DefaultValue="https://localhost:3000/assets/icon-settings-16.png" />
        <bt:Image id="IconSettings.32x32" DefaultValue="https://localhost:3000/assets/icon-settings-32.png" />
        <bt:Image id="IconSettings.80x80" DefaultValue="https://localhost:3000/assets/icon-settings-80.png" />
        <bt:Image id="IconLibreChat.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="IconLibreChat.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="IconLibreChat.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
        <bt:Image id="IconTone.16x16" DefaultValue="https://localhost:3000/assets/icon-tone-16.png" />
        <bt:Image id="IconTone.32x32" DefaultValue="https://localhost:3000/assets/icon-tone-32.png" />
        <bt:Image id="IconTone.80x80" DefaultValue="https://localhost:3000/assets/icon-tone-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
        <bt:Url id="SummarizeTaskpane.Url" DefaultValue="https://localhost:3000/taskpane.html?action=summarize" />
        <bt:Url id="SettingsTaskpane.Url" DefaultValue="https://localhost:3000/taskpane.html?action=settings" />
        <bt:Url id="Tone.Url" DefaultValue="https://localhost:3000/taskpane.html?action=tone" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="AI Assistant" />
        <bt:String id="ComposeGroupLabel" DefaultValue="AI Assistant" />
        <bt:String id="SummarizeButton.Label" DefaultValue="Summarize">
          <bt:Override Locale="pt-PT" Value="Resumir" />
        </bt:String>
        <bt:String id="ReplyButton.Label" DefaultValue="Reply">
          <bt:Override Locale="pt-PT" Value="Responder" />
        </bt:String>
        <bt:String id="SettingsButton.Label" DefaultValue="Settings">
          <bt:Override Locale="pt-PT" Value="Definições" />
        </bt:String>
        <bt:String id="ComposeDefaultReply.Label" DefaultValue="Default Reply">
          <bt:Override Locale="pt-PT" Value="Resposta Predefinida" />
        </bt:String>
        <bt:String id="ComposeCustomReply.Label" DefaultValue="Reply with Instructions">
          <bt:Override Locale="pt-PT" Value="Responder com Instruções" />
        </bt:String>
        <bt:String id="ToneMenu.Label" DefaultValue="Change Tone">
          <bt:Override Locale="pt-PT" Value="Alterar Tom" />
        </bt:String>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="SummarizeButton.Tooltip" DefaultValue="Get an AI summary of this email">
          <bt:Override Locale="pt-PT" Value="Obter um resumo deste e-mail com IA" />
        </bt:String>
        <bt:String id="ReplyButton.Tooltip" DefaultValue="Generate an AI reply and open the reply form">
          <bt:Override Locale="pt-PT" Value="Gerar uma resposta com IA e abrir o formulário de resposta" />
        </bt:String>
        <bt:String id="SettingsButton.Tooltip" DefaultValue="Open settings">
          <bt:Override Locale="pt-PT" Value="Abrir definições" />
        </bt:String>
        <bt:String id="ComposeDefaultReply.Tooltip" DefaultValue="Generate a reply using the default prompt">
          <bt:Override Locale="pt-PT" Value="Gerar uma resposta usando o prompt predefinido" />
        </bt:String>
        <bt:String id="ComposeCustomReply.Tooltip" DefaultValue="Edit the prompt instructions before generating a reply">
          <bt:Override Locale="pt-PT" Value="Editar as instruções do prompt antes de gerar uma resposta" />
        </bt:String>
        <bt:String id="ToneMenu.Tooltip" DefaultValue="Select text in your email, then rewrite it in a different tone">
          <bt:Override Locale="pt-PT" Value="Selecione texto no seu e-mail e reescreva-o noutro tom" />
        </bt:String>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
